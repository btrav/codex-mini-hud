diff --git a/codex-rs/tui/src/chatwidget/mini_hud.rs b/codex-rs/tui/src/chatwidget/mini_hud.rs
new file mode 100644
index 0000000000..485aaad290
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/mini_hud.rs
@@ -0,0 +1,743 @@
+use super::*;
+use codex_protocol::config_types::ServiceTier;
+use ratatui::prelude::Stylize;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use unicode_width::UnicodeWidthStr;
+
+const SEPARATOR: &str = " · ";
+const CONTEXT_CELLS: usize = 10;
+const LIMIT_CELLS: usize = 5;
+
+pub(super) fn mini_hud_process_origin() -> Instant {
+    let elapsed = std::env::var("CODEX_MINI_HUD_STARTED_AT")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .and_then(|started_at| {
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .ok()
+                .map(|now| now.as_secs().saturating_sub(started_at))
+        })
+        .map(Duration::from_secs)
+        .unwrap_or_default();
+    Instant::now()
+        .checked_sub(elapsed)
+        .unwrap_or_else(Instant::now)
+}
+
+#[derive(Clone, Copy)]
+enum Tone {
+    Brand,
+    Good,
+    Warn,
+    Danger,
+    Info,
+    Positive,
+    Muted,
+}
+
+struct HudField {
+    segments: Vec<HudSegment>,
+    drop_rank: u8,
+    separator: &'static str,
+}
+
+struct HudSegment {
+    text: String,
+    tone: Tone,
+}
+
+impl HudField {
+    fn new(text: impl Into<String>, tone: Tone, drop_rank: u8) -> Self {
+        Self {
+            segments: vec![HudSegment {
+                text: text.into(),
+                tone,
+            }],
+            drop_rank,
+            separator: SEPARATOR,
+        }
+    }
+
+    fn attached(text: impl Into<String>, tone: Tone, drop_rank: u8) -> Self {
+        Self {
+            segments: vec![HudSegment {
+                text: text.into(),
+                tone,
+            }],
+            drop_rank,
+            separator: " ",
+        }
+    }
+
+    fn segmented(segments: Vec<HudSegment>, drop_rank: u8) -> Self {
+        Self {
+            segments,
+            drop_rank,
+            separator: SEPARATOR,
+        }
+    }
+
+    fn attached_segmented(segments: Vec<HudSegment>, drop_rank: u8) -> Self {
+        Self {
+            segments,
+            drop_rank,
+            separator: " ",
+        }
+    }
+
+    fn text(&self) -> String {
+        self.segments
+            .iter()
+            .map(|segment| segment.text.as_str())
+            .collect()
+    }
+}
+
+impl ChatWidget {
+    pub(super) fn mini_hud_line(&self) -> Line<'static> {
+        let use_colors = self.config.tui_status_line_use_colors
+            && std::env::var_os("NO_COLOR").is_none()
+            && std::env::var("TERM").ok().as_deref() != Some("dumb");
+        let width = self
+            .last_rendered_width
+            .get()
+            .unwrap_or(120)
+            .saturating_sub(2);
+        let medium = width < 92;
+        let narrow = width < 75;
+        let minimal = width < 45;
+        let full_access = mini_hud_full_access(&self.config);
+        let credits_alert = self.codex_spend_control_reached == Some(true)
+            || matches!(
+                self.codex_rate_limit_reached_type,
+                Some(
+                    RateLimitReachedType::WorkspaceOwnerCreditsDepleted
+                        | RateLimitReachedType::WorkspaceMemberCreditsDepleted
+                        | RateLimitReachedType::WorkspaceOwnerUsageLimitReached
+                        | RateLimitReachedType::WorkspaceMemberUsageLimitReached
+                )
+            );
+        let mut fields = Vec::new();
+
+        fields.push(HudField::new("✦Codex✦", Tone::Brand, 0));
+
+        if full_access {
+            fields.push(HudField::attached(
+                if minimal { "!full!" } else { "!full access!" },
+                Tone::Danger,
+                0,
+            ));
+        }
+
+        match self.status_line_context_used_percent() {
+            Some(used) if minimal => fields.push(HudField::attached(
+                format!("{used}%"),
+                threshold_tone(used),
+                0,
+            )),
+            Some(used) => fields.push(HudField::attached_segmented(
+                context_segments(used, if narrow { 5 } else { CONTEXT_CELLS }),
+                0,
+            )),
+            None => fields.push(HudField::attached("ctx ?", Tone::Muted, 0)),
+        }
+
+        if let Some(window) = self
+            .rate_limit_snapshots_by_limit_id
+            .get("codex")
+            .and_then(|snapshot| snapshot.primary.as_ref())
+        {
+            let remaining = (100.0 - window.used_percent).clamp(0.0, 100.0).round() as i64;
+            let reset = (remaining <= 24)
+                .then(|| window.resets_at_epoch.and_then(reset_eta))
+                .flatten();
+            let text = match (reset, medium) {
+                (_, true) => limit_battery(remaining),
+                (Some(reset), false) => format!("{} {reset}", limit_battery(remaining)),
+                (None, false) => limit_battery(remaining),
+            };
+            fields.push(HudField::new(text, remaining_tone(remaining), 0));
+        } else {
+            fields.push(HudField::new("limit ?", Tone::Muted, 0));
+        }
+
+        if credits_alert {
+            fields.push(HudField::attached("!credits!", Tone::Danger, 0));
+        }
+
+        if self.current_service_tier() == Some(ServiceTier::Fast.request_value()) {
+            fields.push(HudField::new("fast", Tone::Warn, 3));
+        }
+
+        if !narrow {
+            fields.push(HudField::new(
+                if medium {
+                    format_duration_compact(self.mini_hud_started_at.elapsed())
+                } else {
+                    format_duration(self.mini_hud_started_at.elapsed())
+                },
+                Tone::Muted,
+                4,
+            ));
+        }
+
+        let lines_added = self
+            .mini_hud_lines_added
+            .saturating_add(self.mini_hud_pending_diff.0);
+        let lines_removed = self
+            .mini_hud_lines_removed
+            .saturating_add(self.mini_hud_pending_diff.1);
+        if !narrow && (lines_added > 0 || lines_removed > 0) {
+            let (added, removed) = if medium {
+                (format_count(lines_added), format_count(lines_removed))
+            } else {
+                (lines_added.to_string(), lines_removed.to_string())
+            };
+            fields.push(HudField::segmented(
+                vec![
+                    HudSegment {
+                        text: format!("+{added}"),
+                        tone: Tone::Positive,
+                    },
+                    HudSegment {
+                        text: format!(" -{removed}"),
+                        tone: Tone::Danger,
+                    },
+                ],
+                5,
+            ));
+        }
+
+        if !medium && let Some(streak) = self.mini_hud_streak_days.filter(|days| *days > 1) {
+            fields.push(HudField::new(format!("♨{streak}d"), Tone::Warn, 7));
+        }
+
+        if !narrow && self.mini_hud_compactions > 0 {
+            fields.push(HudField::new(
+                format!("⟳{}", self.mini_hud_compactions),
+                Tone::Info,
+                6,
+            ));
+        }
+
+        let model = compact_model_name(self.model_display_name());
+        let effort = self.reasoning_display_name();
+        if medium {
+            fields.push(HudField::new(format!("{model}/{effort}"), Tone::Muted, 1));
+        } else {
+            fields.push(HudField::new(model, Tone::Muted, 1));
+            fields.push(HudField::new(effort, Tone::Muted, 2));
+        }
+
+        fit_fields(&mut fields, width);
+        bound_fields(&mut fields, width);
+        self.schedule_mini_hud_tick();
+        render_fields(fields, use_colors)
+    }
+
+    fn schedule_mini_hud_tick(&self) {
+        if self.mini_hud_tick_scheduled.replace(true) {
+            return;
+        }
+        let tx = self.app_event_tx.clone();
+        let widget_origin = self.mini_hud_widget_origin;
+        tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_secs(60)).await;
+            tx.send(AppEvent::MiniHudTick { widget_origin });
+        });
+    }
+
+    pub(crate) fn mini_hud_tick(&mut self, widget_origin: Instant) {
+        if self.mini_hud_widget_origin != widget_origin {
+            return;
+        }
+        self.mini_hud_tick_scheduled.set(false);
+        if self.mini_hud_enabled {
+            self.refresh_status_line();
+        }
+    }
+
+    pub(crate) fn mini_hud_set_account_streak(&mut self, streak: Option<i64>) {
+        if let Some(streak) = streak.filter(|days| *days >= 0) {
+            self.mini_hud_streak_days = Some(streak);
+        }
+        self.refresh_status_line();
+    }
+
+    pub(crate) fn mini_hud_inherit_process_state(&mut self, previous: &Self) {
+        // Only completed turns belong to the process total. The pending diff is
+        // cumulative for the previous thread's active turn and may grow while
+        // that thread is inactive; folding it in here would double-count it
+        // when replay later supplies the thread's newer cumulative diff.
+        self.mini_hud_lines_added = previous.mini_hud_lines_added;
+        self.mini_hud_lines_removed = previous.mini_hud_lines_removed;
+        self.mini_hud_pending_diff = (0, 0);
+        // Compactions belong to the destination thread. Replay will repopulate
+        // this count from that thread's ContextCompaction items.
+        self.mini_hud_compactions = 0;
+        self.mini_hud_streak_days = previous.mini_hud_streak_days;
+        if self.mini_hud_enabled {
+            self.refresh_status_line();
+        }
+    }
+
+    pub(super) fn mini_hud_note_compaction(&mut self) {
+        self.mini_hud_compactions = self.mini_hud_compactions.saturating_add(1);
+        self.refresh_status_line();
+    }
+
+    pub(super) fn mini_hud_update_turn_diff(&mut self, unified_diff: &str) {
+        self.mini_hud_pending_diff = diff_line_counts(unified_diff);
+        self.refresh_status_line();
+    }
+
+    pub(super) fn mini_hud_finish_turn(&mut self) {
+        self.mini_hud_lines_added = self
+            .mini_hud_lines_added
+            .saturating_add(self.mini_hud_pending_diff.0);
+        self.mini_hud_lines_removed = self
+            .mini_hud_lines_removed
+            .saturating_add(self.mini_hud_pending_diff.1);
+        self.mini_hud_pending_diff = (0, 0);
+        self.refresh_status_line();
+    }
+}
+
+fn render_fields(fields: Vec<HudField>, use_colors: bool) -> Line<'static> {
+    let mut spans = Vec::new();
+    for field in fields {
+        if !spans.is_empty() {
+            spans.push(if use_colors {
+                field.separator.dim()
+            } else {
+                Span::raw(field.separator)
+            });
+        }
+        for segment in field.segments {
+            spans.push(Span::styled(
+                segment.text,
+                tone_style(segment.tone, use_colors),
+            ));
+        }
+    }
+    Line::from(spans)
+}
+
+fn tone_style(tone: Tone, use_colors: bool) -> Style {
+    if !use_colors {
+        return Style::default();
+    }
+    let color = match tone {
+        Tone::Brand => Color::LightMagenta,
+        Tone::Good | Tone::Positive => Color::LightGreen,
+        Tone::Warn => Color::LightYellow,
+        Tone::Danger => Color::LightRed,
+        Tone::Info => Color::LightCyan,
+        Tone::Muted => Color::Gray,
+    };
+    let mut style = Style::default().fg(color);
+    if matches!(tone, Tone::Brand | Tone::Danger) {
+        style = style.add_modifier(Modifier::BOLD);
+    }
+    style
+}
+
+fn fit_fields(fields: &mut Vec<HudField>, width: usize) {
+    while fields_width(fields) > width {
+        let Some((index, _)) = fields
+            .iter()
+            .enumerate()
+            .filter(|(_, field)| field.drop_rank > 0)
+            .max_by_key(|(_, field)| field.drop_rank)
+        else {
+            break;
+        };
+        fields.remove(index);
+    }
+}
+
+fn bound_fields(fields: &mut Vec<HudField>, width: usize) {
+    if fields_width(fields) <= width {
+        return;
+    }
+
+    let brand = fields
+        .first()
+        .map(HudField::text)
+        .unwrap_or_else(|| "✦Codex✦".to_string());
+    let alerts = fields
+        .iter()
+        .filter(|field| {
+            field.segments.iter().any(|segment| {
+                matches!(segment.tone, Tone::Danger) && segment.text.starts_with('!')
+            })
+        })
+        .map(|field| field.text())
+        .collect::<Vec<_>>();
+    let context = fields
+        .iter()
+        .find(|field| {
+            let text = field.text();
+            text.contains('%') || text.starts_with("ctx ")
+        })
+        .map(HudField::text);
+    let limit = fields
+        .iter()
+        .find(|field| field.text().contains('▮') || field.text().contains('▯'))
+        .map(HudField::text);
+
+    fields.clear();
+    fields.push(HudField::new(brand, Tone::Brand, 0));
+    for alert in alerts {
+        let short = if alert.contains("full") {
+            "!full!"
+        } else {
+            "!credits!"
+        };
+        fields.push(HudField::attached(short, Tone::Danger, 0));
+    }
+    if fields_width(fields) < width {
+        if let Some(context) = context {
+            let percent = context
+                .split_whitespace()
+                .last()
+                .unwrap_or(context.as_str())
+                .to_string();
+            fields.push(HudField::new(percent, Tone::Muted, 1));
+        }
+        if let Some(limit) = limit {
+            fields.push(HudField::new(limit, Tone::Muted, 2));
+        }
+        fit_fields(fields, width);
+    }
+
+    while fields_width(fields) > width && fields.len() > 1 {
+        fields.pop();
+    }
+    if fields_width(fields) > width {
+        let text = fields[0].text();
+        let bounded = text.chars().take(width).collect::<String>();
+        fields[0] = HudField::new(bounded, Tone::Brand, 0);
+    }
+}
+
+fn fields_width(fields: &[HudField]) -> usize {
+    fields
+        .iter()
+        .map(|field| UnicodeWidthStr::width(field.text().as_str()))
+        .sum::<usize>()
+        + fields
+            .iter()
+            .skip(1)
+            .map(|field| UnicodeWidthStr::width(field.separator))
+            .sum::<usize>()
+}
+
+#[cfg(test)]
+fn context_bar(used: i64) -> String {
+    context_bar_cells(used, CONTEXT_CELLS)
+}
+
+#[cfg(test)]
+fn context_bar_cells(used: i64, cells: usize) -> String {
+    let used = used.clamp(0, 100);
+    let filled = if used == 100 {
+        cells
+    } else {
+        (used * cells as i64 / 100) as usize
+    };
+    format!(
+        "{}{} {used:>3}%",
+        "▓".repeat(filled),
+        "░".repeat(cells - filled)
+    )
+}
+
+fn context_segments(used: i64, cells: usize) -> Vec<HudSegment> {
+    let used = used.clamp(0, 100);
+    let filled = if used == 100 {
+        cells
+    } else {
+        (used * cells as i64 / 100) as usize
+    };
+    let mut segments = (0..cells)
+        .map(|index| HudSegment {
+            text: if index < filled { "▓" } else { "░" }.to_string(),
+            tone: if index >= filled {
+                Tone::Muted
+            } else if index * 10 >= cells * 8 {
+                Tone::Danger
+            } else if index * 10 >= cells * 6 {
+                Tone::Warn
+            } else {
+                Tone::Good
+            },
+        })
+        .collect::<Vec<_>>();
+    segments.push(HudSegment {
+        text: format!(" {used:>3}%"),
+        tone: threshold_tone(used),
+    });
+    segments
+}
+
+fn limit_battery(remaining: i64) -> String {
+    let cells = match remaining {
+        85..=100 => 5,
+        65..=84 => 4,
+        45..=64 => 3,
+        25..=44 => 2,
+        11..=24 => 1,
+        _ => 0,
+    };
+    format!("{}{}", "▮".repeat(cells), "▯".repeat(LIMIT_CELLS - cells))
+}
+
+fn threshold_tone(used: i64) -> Tone {
+    match used {
+        90.. => Tone::Danger,
+        70.. => Tone::Warn,
+        _ => Tone::Good,
+    }
+}
+
+fn remaining_tone(remaining: i64) -> Tone {
+    match remaining {
+        0..=10 => Tone::Danger,
+        11..=24 => Tone::Warn,
+        _ => Tone::Good,
+    }
+}
+
+fn reset_eta(epoch: i64) -> Option<String> {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()?
+        .as_secs() as i64;
+    let seconds = epoch.saturating_sub(now);
+    if seconds <= 0 {
+        return Some("soon".to_string());
+    }
+    if seconds < 60 {
+        return Some("<1m".to_string());
+    }
+    let minutes = (seconds + 59) / 60;
+    if minutes < 60 {
+        Some(format!("~{minutes}m"))
+    } else {
+        Some(format!("~{}h{:02}m", minutes / 60, minutes % 60))
+    }
+}
+
+fn format_duration(duration: Duration) -> String {
+    let minutes = duration.as_secs() / 60;
+    let hours = minutes / 60;
+    let minutes = minutes % 60;
+    if hours > 0 {
+        format!("{hours}h {minutes}m")
+    } else {
+        format!("{minutes}m")
+    }
+}
+
+fn format_duration_compact(duration: Duration) -> String {
+    let minutes = duration.as_secs() / 60;
+    if minutes >= 60 {
+        format!("{}h", minutes / 60)
+    } else if minutes == 0 {
+        "<1m".to_string()
+    } else {
+        format!("{minutes}m")
+    }
+}
+
+fn format_count(value: u64) -> String {
+    if value < 1_000 {
+        value.to_string()
+    } else if value < 10_000 {
+        let rounded = value as f64 / 1_000.0;
+        format!("{rounded:.1}k").replace(".0k", "k")
+    } else {
+        format!("{}k", value / 1_000)
+    }
+}
+
+fn compact_model_name(model: &str) -> String {
+    let model = model.strip_prefix("openai/").unwrap_or(model);
+    let suffix = if model.ends_with("-sol") {
+        "S"
+    } else if model.ends_with("-terra") {
+        "T"
+    } else if model.ends_with("-luna") {
+        "L"
+    } else {
+        ""
+    };
+    if let Some(version) = model.strip_prefix("gpt-") {
+        let version = version
+            .split_once('-')
+            .map_or(version, |(version, _)| version);
+        return format!("G{version}{suffix}");
+    }
+    if model.is_empty() {
+        "model ?".to_string()
+    } else if UnicodeWidthStr::width(model) <= 8 {
+        model.to_string()
+    } else {
+        format!("{}…", model.chars().take(7).collect::<String>())
+    }
+}
+
+fn diff_line_counts(diff: &str) -> (u64, u64) {
+    diff.lines().fold((0, 0), |(added, removed), line| {
+        if line.starts_with("+++") || line.starts_with("---") {
+            (added, removed)
+        } else if line.starts_with('+') {
+            (added + 1, removed)
+        } else if line.starts_with('-') {
+            (added, removed + 1)
+        } else {
+            (added, removed)
+        }
+    })
+}
+
+fn mini_hud_full_access(config: &Config) -> bool {
+    config.permissions.effective_permission_profile() == PermissionProfile::Disabled
+}
