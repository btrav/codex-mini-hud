+            (2, 1)
+        );
+    }
+
+    #[test]
+    fn responsive_fit_drops_low_value_fields_first() {
+        let mut fields = vec![
+            HudField::new("✦Codex✦", Tone::Brand, 0),
+            HudField::new("█████░░░░░ 50%", Tone::Good, 0),
+            HudField::new("12h 4m", Tone::Muted, 4),
+            HudField::new("♨3d", Tone::Warn, 7),
+            HudField::new("gpt-5.6", Tone::Info, 0),
+        ];
+        fit_fields(&mut fields, 42);
+        assert!(fields.iter().all(|field| field.text() != "♨3d"));
+        assert!(fields.iter().any(|field| field.text() == "gpt-5.6"));
+    }
+
+    #[test]
+    fn no_color_uses_default_style_for_every_span() {
+        let line = render_fields(
+            vec![
+                HudField::new("✦Codex✦", Tone::Brand, 0),
+                HudField::new("▮▮▯▯▯", Tone::Warn, 0),
+            ],
+            false,
+        );
+        assert!(line.spans.iter().all(|span| span.style == Style::default()));
+    }
+
+    #[test]
+    fn diff_additions_and_removals_have_distinct_tones() {
+        let field = HudField::segmented(
+            vec![
+                HudSegment {
+                    text: "+12".to_string(),
+                    tone: Tone::Positive,
+                },
+                HudSegment {
+                    text: " -3".to_string(),
+                    tone: Tone::Danger,
+                },
+            ],
+            5,
+        );
+        let line = render_fields(vec![field], true);
+        assert_eq!(line.spans[0].style.fg, Some(Color::LightGreen));
+        assert_eq!(line.spans[1].style.fg, Some(Color::LightRed));
+    }
+
+    #[test]
+    fn bounded_fallback_never_exceeds_terminal_width() {
+        for width in 0..45 {
+            let mut fields = vec![
+                HudField::new("✦Codex✦", Tone::Brand, 0),
+                HudField::attached("!full access!", Tone::Danger, 0),
+                HudField::attached("!credits!", Tone::Danger, 0),
+                HudField::new("▓▓▓▓▓░░░░░  53%", Tone::Good, 0),
+                HudField::new("▮▮▯▯▯", Tone::Good, 0),
+                HudField::new("G5.6S/high", Tone::Muted, 1),
+            ];
+            fit_fields(&mut fields, width);
+            bound_fields(&mut fields, width);
+            assert!(fields_width(&fields) <= width, "overflow at width {width}");
+        }
+    }
+
+    #[test]
+    fn wide_plain_line_matches_expected_shape() {
+        let line = render_fields(
+            vec![
+                HudField::new("✦Codex✦", Tone::Brand, 0),
+                HudField::attached_segmented(context_segments(53, 10), 0),
+                HudField::new("▮▮▯▯▯", Tone::Good, 0),
+                HudField::new("2h 14m", Tone::Muted, 4),
+                HudField::segmented(
+                    vec![
+                        HudSegment {
+                            text: "+1079".to_string(),
+                            tone: Tone::Positive,
+                        },
+                        HudSegment {
+                            text: " -239".to_string(),
+                            tone: Tone::Danger,
+                        },
+                    ],
+                    5,
+                ),
+                HudField::new("♨7d", Tone::Muted, 7),
+                HudField::new("G5.6S", Tone::Muted, 1),
+                HudField::new("high", Tone::Muted, 2),
+            ],
+            false,
+        );
+        let plain = line
+            .spans
+            .iter()
+            .map(|span| span.content.as_ref())
+            .collect::<String>();
+        assert_eq!(
+            plain,
+            "✦Codex✦ ▓▓▓▓▓░░░░░  53% · ▮▮▯▯▯ · 2h 14m · +1079 -239 · ♨7d · G5.6S · high"
+        );
+    }
+}
